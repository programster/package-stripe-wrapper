# PHPStan settings. Run with: vendor/bin/phpstan
# Level 10, the highest. Each request model's array form declares its exact shape, so PHPStan checks what's sent
# against the shapes the Stripe SDK declares for each request. The one exception, ignored below, is the empty string
# that removes billing thresholds, which Stripe takes but the SDK's shapes leave out.
parameters:
    level: 10
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - src
        - testing
    excludePaths:
        - testing/settings.php
    # The live tests read their settings from testing/settings.php, which isn't committed, so the template's
    # constants are loaded instead, and treated as unknown values rather than the template's defaults.
    bootstrapFiles:
        - testing/settings.php.tmpl
    ignoreErrors:
        # Stripe takes an empty string to remove billing thresholds, which BillingThresholds(null) sends, but the
        # SDK's array shapes for these two calls leave the empty string out, so they can't be satisfied without
        # changing what's sent.
        -
            message: '#^Parameter \#\d \$params of method Stripe\\Service\\Subscription(Item)?Service::(update|create)\(\) expects .*billing_thresholds\?: \x27\x27\|array\{usage_gte: int\}#'
            identifier: argument.type
            path: src/StripeClient.php
            count: 2
        # Accessors are one line, with no docblock, so these can't say what their arrays hold. The properties they
        # return do say.
        -
            identifier: missingType.iterableValue
            path: src/models/TaxRates.php
            count: 1
        -
            identifier: missingType.iterableValue
            path: testing/RecordedRequest.php
            count: 1
        -
            identifier: missingType.iterableValue
            path: testing/SmokeTest.php
            count: 2
    dynamicConstantNames:
        - STRIPE_SECRET_KEY
        - STRIPE_TAX_IS_SET_UP
        - STRIPE_TERMS_OF_SERVICE_URL_IS_SET
        - STRIPE_CONNECTED_ACCOUNT_ID
